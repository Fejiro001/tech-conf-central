@model IEnumerable<TechConfCentral.Models.Track>

@{
    ViewData["Title"] = "Admin - Tracks";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <span class="section-label d-block text-muted font-monospace small">// MANAGEMENT</span>
        <h1 class="h2 text-white font-monospace m-0">TRACKS_</h1>
    </div>
    <a asp-action="Create" class="btn btn-outline-success font-monospace">
        <i class="fa-solid fa-plus me-1"></i> CREATE NEW
    </a>
</div>

<div class="card bg-dark border-secondary">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle m-0">
                <thead>
                    <tr class="border-bottom border-secondary font-monospace text-muted small">
                        <th class="ps-4">#</th>
                        <th>TRACK NAME</th>
                        <th>COLOR BADGE</th>
                        <th>DESCRIPTION</th>
                        <th>SCHEDULED TALKS</th>
                        <th class="text-end pe-4">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted font-monospace">
                                No tracks configured. Click "Create New" to add one.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var track in Model)
                        {
                            <tr>
                                <td class="ps-4 font-monospace text-muted">@track.Id</td>
                                <td>
                                    <strong class="text-white font-monospace">@track.Name</strong>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(track.Color))
                                    {
                                        <span class="badge border font-monospace" style="background-color: @track.Color; color: #fff;">
                                            @track.Color
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary text-dark font-monospace">NONE</span>
                                    }
                                </td>
                                <td class="font-monospace text-muted small text-truncate" style="max-width: 300px;">
                                    @(string.IsNullOrEmpty(track.Description) ? "No description provided." : track.Description)
                                </td>
                                <td class="font-monospace text-muted small">
                                    @(track.Talks?.Count ?? 0) talk(s)
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@track.Id" class="btn btn-outline-warning" title="Edit">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@track.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete track: @track.Name?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>