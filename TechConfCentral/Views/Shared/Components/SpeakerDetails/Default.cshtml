@model SpeakerDetailsViewModel

@if (Model?.Speaker != null)
{
    var speaker = Model.Speaker;

    <div class="tc-speaker-modal-wrapper">
        <!-- HEADER: AVATAR & META -->
        <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-4 mb-4">
            <div class="tc-modal-avatar">
                <img src="@(string.IsNullOrEmpty(speaker.ProfileImage) ? "https://api.dicebear.com/10.x/notionists/svg?seed=Unknown" : speaker.ProfileImage)"
                     alt="@speaker.FirstName @speaker.LastName" />
            </div>
            <div class="tc-modal-speaker-info">
                <h2 class="tc-modal-speaker-name m-0 text-lowercase">@speaker.FirstName @speaker.LastName</h2>
                <p class="tc-modal-speaker-role m-0 mt-1">
                    @speaker.JobTitle.ToUpper() @@@speaker.Company.ToUpper()
                </p>
            </div>
        </div>

        <hr class="tc-modal-divider" />

        <!-- BIO -->
        <div class="tc-modal-bio my-4">
            <p class="m-0">
                @(string.IsNullOrEmpty(speaker.Biography) ? "No bio available for this speaker." : speaker.Biography)
            </p>
        </div>

        <hr class="tc-modal-divider" />

        <div class="tc-talk-label mt-3">// TALK(S)</div>
        @foreach (Talk talk in speaker.Talks)
        {
            if (talk != null)
            {
                var trackTextColor = !string.IsNullOrWhiteSpace(talk.Track?.Color) ? talk.Track.Color : "var(--green-200)";
                var collapseId = $"talkDetails-{talk.Id}";

                <!-- TALK TICKET CARD -->
                <div class="tc-talk-section mt-2">
                    <div class="ticket-card" style="background-color:@trackTextColor;">
                        <!-- Vertical Badge -->
                        <div class="tc-ticket-badge" style="color:@trackTextColor;">
                            @talk.Track?.Name
                        </div>

                        <!-- Main Ticket Body -->
                        <div class="tc-ticket-body">
                            <h3 class="tc-ticket-title m-0">@talk.Title.ToLower()</h3>
                            <p class="tc-ticket-author m-0 mt-3">
                                @speaker.FirstName.ToUpper() @speaker.LastName.ToUpper()                         
                                <span> // @talk.Speaker.Company</span>
                            </p>

                            <!-- Collapsible details -->
                            <div class="collapse mt-3" id="@collapseId">
                                <div class="ticket-accordion-body">
                                    @if (!string.IsNullOrEmpty(talk.Description))
                                    {
                                        <p class="ticket-talk-description line-clamp-2">
                                            @talk.Description
                                        </p>
                                    }

                                    @if (talk.Room != null)
                                    {
                                        <div class="d-flex flex-wrap gap-2 mt-2">
                                            <span class="ticket-meta-pill">
                                                Location: @talk.Room.Name
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>

                            <button class="btn-ticket-accordion text-uppercase mt-4"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#@collapseId"
                                    aria-expanded="false"
                                    aria-controls="@collapseId">
                                <i class="fa-solid fa-plus"></i>
                                <span class="btn-text">Talk Details</span>
                            </button>
                        </div>

                        <!-- Ticket Stub -->
                        <div class="tc-ticket-stub">
                            <div class="tc-ticket-time text-center">
                                <span class="time-main d-block">9:00</span>
                                <span class="time-sub d-block">10:00</span>
                            </div>

                            <div>
                                <img class="ticket-barcode" src="~/images/code.png" alt="Barcode" />
                            </div>
                        </div>
                    </div>
                </div>
            }
        }        
    </div>
}