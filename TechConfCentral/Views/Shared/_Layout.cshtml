@{
    var conferenceId = Context.Session.GetInt32("CurrentConferenceId");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechConfCentral</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet">
    <!-- FontAwesome & Base CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css" integrity="sha512-ApSLB1Pd3/bZN8fWB/RG9YhN/7bd9Hkf3AGaE2mPfebjrxagjuBtx2GcgdqIlJkUzwylBo61r9Xa9NmgBI0swA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TechConfCentral.styles.css" asp-append-version="true" />
</head>
<body class="site-body">
    @if (User.IsInRole("Admin"))
    {
        <div class="bg-warning text-dark py-1 px-3 d-flex justify-content-between align-items-center font-monospace small">
            <div>
                <i class="fa-solid fa-user-gear me-1"></i> <strong>ADMIN MODE</strong>
            </div>
            <div class="d-flex gap-3">
                <a asp-controller="AdminConference" asp-action="Index" class="text-dark text-decoration-none fw-bold">Conferences</a>
                <span>|</span>
                <a asp-controller="AdminRoom" asp-action="Index" class="text-dark text-decoration-none fw-bold">Rooms</a>
                <span>|</span>
                <a asp-controller="AdminSpeaker" asp-action="Index" class="text-dark text-decoration-none fw-bold">Speakers</a>
                <span>|</span>
                <a asp-controller="AdminTalk" asp-action="Index" class="text-dark text-decoration-none fw-bold">Talks</a>
                <span>|</span>
                <a asp-controller="AdminTrack" asp-action="Index" class="text-dark text-decoration-none fw-bold">Tracks</a>
            </div>
        </div>
    }
    <header class="site-header border-bottom">
        <nav class="navbar navbar-expand-md py-3">
            <div class="container-lg">
                <a class="navbar-brand site-logo" asp-area="" asp-controller="Home" asp-action="Index">TECHCONFCENTRAL_</a>
                
                <button class="navbar-toggler custom-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="fa-solid fa-bars toggler-fa-icon"></i>
                </button>

                <div class="collapse navbar-collapse justify-content-end" id="navbarContent">
                    <ul class="navbar-nav gap-3 mt-3 mt-md-0 me-md-2">
                        <li class="nav-item">
                            <a class="nav-link nav-btn" asp-area="" asp-controller="Conference" asp-action="Index" asp-route-conferenceId="@conferenceId">OVERVIEW</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-btn" asp-area="" asp-controller="Conference" asp-action="Schedule" asp-route-conferenceId="@conferenceId">SCHEDULE</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-btn" asp-area="" asp-controller="Conference" asp-action="Speakers" asp-route-conferenceId="@conferenceId">SPEAKERS</a>
                        </li>
                        <partial name="_LoginPartial" />
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-lg site-main py-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- SPEAKER POPUP MODAL -->
    <div class="modal fade" id="speakerModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content tc-modal-content position-relative">
                <!-- Boxed Close Button -->
                <button type="button" class="tc-modal-close-btn" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fa-solid fa-xmark"></i>
                </button>

                <div class="modal-body p-4 p-md-5" id="speakerModalBody">
                    <!-- Content loaded dynamically -->
                </div>
            </div>
        </div>
    </div>

    <footer class="container main-footer">
        <div class="container">
            <div class="main-footer-grid">
                <div class="main-footer-col main-footer-brand-col">
                    <h3 class="main-footer-logo">TECHCONFCENTRAL_</h3>
                    <p class="main-footer-desc">
                        A three-day conference for engineers who build the interfaces humans use every day.
                    </p>
                </div>

                <!-- Navigate Column -->
                <div class="main-footer-col">
                    <h4 class="main-footer-heading">// NAVIGATE</h4>
                    <ul class="main-footer-links">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="Conference" asp-action="Schedule">Schedule</a></li>
                        <li><a asp-controller="Conference" asp-action="Speakers">Speakers</a></li>
                    </ul>
                </div>

                <!-- Tracks Column -->
                <div class="main-footer-col">
                    <h4 class="main-footer-heading">// TRACKS</h4>
                    <ul class="main-footer-links">
                        <li><span>Frontend</span></li>
                        <li><span>Performance</span></li>
                        <li><span>Accessibility</span></li>
                        <li><span>Tooling</span></li>
                    </ul>
                </div>

                <!-- Venue Column -->
                <div class="main-footer-col">
                    <h4 class="main-footer-heading">// VENUE</h4>
                    <address class="main-footer-venue">
                        Pier 70<br />
                        San Francisco, CA<br />
                        Nov 15–17, 2026
                    </address>
                </div>
            </div>

            <!-- Bottom Bar -->
            <div class="main-footer-bottom">
                <span class="main-footer-copy">&copy; 2026 TECHCONFCENTRAL. ALL RIGHTS RESERVED.</span>
                <a href="#" class="main-footer-back-to-top">BACK TO TOP &uarr;</a>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
                    function openSpeakerModal(speakerId) {
                const modalElement = document.getElementById('speakerModal');
                const modalBody = document.getElementById('speakerModalBody');
                const bsModal = bootstrap.Modal.getOrCreateInstance(modalElement);

                // Set loading spinner state
                modalBody.innerHTML = `
                    <div class="text-center py-5">
                        <i class="fa-solid fa-spinner fa-spin fs-1 text-green"></i>
                        <p class="mt-3 text-muted font-monospace">Loading speaker profile...</p>
                    </div>
                `;

                bsModal.show();

                // Fetch rendered HTML from ViewComponent endpoint
                fetch(`/Conference/GetSpeakerModalComponent?speakerId=${speakerId}`)
                    .then(response => {
                        if (!response.ok) throw new Error('Failed to load speaker profile.');
                        return response.text();
                    })
                    .then(html => {
                        modalBody.innerHTML = html;
                    })
                    .catch(err => {
                        modalBody.innerHTML = `
                            <div class="text-center py-4">
                                <i class="fa-solid fa-triangle-exclamation fs-1 text-warning mb-2"></i>
                                <p class="text-muted font-monospace m-0">${err.message}</p>
                            </div>
                        `;
                    });
            }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
