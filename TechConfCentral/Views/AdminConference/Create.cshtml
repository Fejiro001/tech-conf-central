@model TechConfCentral.Models.Conference

@{
    ViewData["Title"] = "Create Conference";
}

<div class="mb-4">
    <a asp-action="Index" class="text-muted text-decoration-none font-monospace small">
        <i class="fa-solid fa-arrow-left"></i> BACK TO LIST
    </a>
    <h1 class="h2 text-white font-monospace mt-2">// CREATE CONFERENCE</h1>
</div>

<div class="row">
    <div class="col-lg-9">
        <div class="card bg-dark border-secondary p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger font-monospace mb-3"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Name" class="form-label font-monospace text-light">Conference Name</label>
                        <input asp-for="Name" class="form-control bg-dark text-white border-secondary" placeholder="e.g. TechConfCentral 2026" />
                        <span asp-validation-for="Name" class="text-danger font-monospace small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Tagline" class="form-label font-monospace text-light">Tagline</label>
                        <input asp-for="Tagline" class="form-control bg-dark text-white border-secondary" placeholder="e.g. The Next Frontier of Web Development" />
                        <span asp-validation-for="Tagline" class="text-danger font-monospace small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Venue" class="form-label font-monospace text-light">Venue</label>
                        <input asp-for="Venue" class="form-control bg-dark text-white border-secondary" placeholder="e.g. Pier 70 Event Center" />
                        <span asp-validation-for="Venue" class="text-danger font-monospace small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="City" class="form-label font-monospace text-light">City</label>
                        <input asp-for="City" class="form-control bg-dark text-white border-secondary" placeholder="e.g. San Francisco" />
                        <span asp-validation-for="City" class="text-danger font-monospace small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="StateOrProvince" class="form-label font-monospace text-light">State / Province</label>
                        <input asp-for="StateOrProvince" class="form-control bg-dark text-white border-secondary" placeholder="e.g. CA or Manitoba" />
                        <span asp-validation-for="StateOrProvince" class="text-danger font-monospace small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Country" class="form-label font-monospace text-light">Country</label>
                        <input asp-for="Country" class="form-control bg-dark text-white border-secondary" placeholder="e.g. USA or Canada" />
                        <span asp-validation-for="Country" class="text-danger font-monospace small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="StartDate" class="form-label font-monospace text-light">Start Date</label>
                        <input asp-for="StartDate" type="date" class="form-control bg-dark text-white border-secondary" />
                        <span asp-validation-for="StartDate" class="text-danger font-monospace small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="EndDate" class="form-label font-monospace text-light">End Date</label>
                        <input asp-for="EndDate" type="date" class="form-control bg-dark text-white border-secondary" />
                        <span asp-validation-for="EndDate" class="text-danger font-monospace small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label font-monospace text-light">Description (Optional)</label>
                    <textarea asp-for="Description" rows="4" class="form-control bg-dark text-white border-secondary" placeholder="Detailed overview of the conference..."></textarea>
                    <span asp-validation-for="Description" class="text-danger font-monospace small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success font-monospace px-4">
                        <i class="fa-solid fa-check me-1"></i> SAVE CONFERENCE
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary font-monospace">CANCEL</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}