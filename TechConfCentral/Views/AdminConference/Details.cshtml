@model TechConfCentral.Models.Conference

@{
    ViewData["Title"] = "Conference Details";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <a asp-action="Index" class="text-muted text-decoration-none font-monospace small">
            &larr; BACK TO LIST
        </a>
        <h1 class="h2 text-white font-monospace mt-1">// DETAILS: @Model.Name.ToUpper()</h1>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning font-monospace">
            <i class="fa-solid fa-pen me-1"></i> EDIT
        </a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this conference?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger font-monospace">
                <i class="fa-solid fa-trash me-1"></i> DELETE
            </button>
        </form>
    </div>
</div>

<div class="row g-4 mb-5">
    <!-- INFO CARD -->
    <div class="col-lg-12">
        <div class="card bg-dark border-secondary p-4">
            <div class="row g-3 font-monospace">
                <div class="col-md-2">
                    <span class="text-muted d-block small">// ID</span>
                    <span class="text-light fs-5">#@Model.Id</span>
                </div>
                <div class="col-md-4">
                    <span class="text-muted d-block small">// TAGLINE</span>
                    <span class="text-light fs-6">@Model.Tagline</span>
                </div>
                <div class="col-md-3">
                    <span class="text-muted d-block small">// LOCATION</span>
                    <span class="text-light fs-6">@Model.Venue</span>
                    <span class="text-muted d-block small">@Model.City, @Model.StateOrProvince, @Model.Country</span>
                </div>
                <div class="col-md-3">
                    <span class="text-muted d-block small">// DATES</span>
                    <span class="text-light fs-6">
                        @Model.StartDate.ToString("MMM dd, yyyy") - @Model.EndDate.ToString("MMM dd, yyyy")
                    </span>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <hr class="border-secondary my-3" />
                <div>
                    <span class="text-muted font-monospace d-block small mb-1">// DESCRIPTION</span>
                    <p class="text-light font-monospace m-0">@Model.Description</p>
                </div>
            }
        </div>
    </div>

    <!-- ASSOCIATED TALKS -->
    <div class="col-lg-12">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="h4 text-white font-monospace m-0">// TALKS PROGRAMMED (@(Model.Talks?.Count ?? 0))</h3>
        </div>

        <div class="card bg-dark border-secondary">
            <div class="card-body p-0">
                <table class="table table-dark table-hover align-middle m-0">
                    <thead>
                        <tr class="border-bottom border-secondary font-monospace text-muted small">
                            <th class="ps-4">TITLE</th>
                            <th>SPEAKER</th>
                            <th>START TIME</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Talks == null || !Model.Talks.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center py-4 text-muted font-monospace">
                                    No talks assigned to this conference yet.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var talk in Model.Talks)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <strong class="text-white">@talk.Title</strong>
                                    </td>
                                    <td class="font-monospace text-light">
                                        @(talk.Speaker != null ? $"{talk.Speaker.FirstName} {talk.Speaker.LastName}" : "TBA")
                                    </td>
                                    <td class="font-monospace text-muted small">
                                        @talk.StartDateTime.ToString("MMM dd, H:mm")
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>