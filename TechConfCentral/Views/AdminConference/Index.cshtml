@model IEnumerable<TechConfCentral.Models.Conference>

@{
    ViewData["Title"] = "Admin - Conferences";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <span class="section-label d-block">// MANAGEMENT</span>
        <h1 class="h2 text-white font-monospace m-0">CONFERENCES_</h1>
    </div>
    <a asp-action="Create" class="btn btn-primary font-monospace py-2">
        <i class="fa-solid fa-plus me-1"></i> CREATE NEW
    </a>
</div>

<div class="card bg-dark border-secondary">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle m-0">
                <thead>
                    <tr class="border-bottom border-secondary font-monospace text-white-50 small">
                        <th class="ps-4">#</th>
                        <th>CONFERENCE</th>
                        <th>VENUE & LOCATION</th>
                        <th>DATES</th>
                        <th class="text-end pe-4">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-white-50 font-monospace">
                                No conferences found. Click "Create New" to add one.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var conf in Model)
                        {
                            <tr>
                                <td class="ps-4 font-monospace text-white-50">@conf.Id</td>
                                <td>
                                    <strong class="text-white d-block">@conf.Name</strong>
                                    <span class="text-white-50 font-monospace small">@conf.Tagline</span>
                                </td>
                                <td class="font-monospace text-light">
                                    <div class="fw-bold">@conf.Venue</div>
                                    <div class="text-white-50 small">@conf.City, @conf.StateOrProvince, @conf.Country</div>
                                </td>
                                <td class="font-monospace text-white-50 small">
                                    @conf.StartDate.ToString("MMM dd, yyyy") - @conf.EndDate.ToString("MMM dd, yyyy")
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2 btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@conf.Id" class="btn btn-outline-info" title="Details">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@conf.Id" class="btn btn-outline-warning" title="Edit">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@conf.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this conference?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="d-inline-flex align-items-center btn btn-outline-danger rounded-0" title="Delete">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>