@model TechConfCentral.Models.Speaker

@{
    ViewData["Title"] = "Speaker Details";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <a asp-action="Index" class="text-muted text-decoration-none font-monospace small">
            &larr; BACK TO LIST
        </a>
        <h1 class="h2 text-white font-monospace mt-1">// DETAILS: @Model.FirstName.ToUpper() @Model.LastName.ToUpper()</h1>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning font-monospace">
            <i class="fa-solid fa-pen me-1"></i> EDIT
        </a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this speaker?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger font-monospace">
                <i class="fa-solid fa-trash me-1"></i> DELETE
            </button>
        </form>
    </div>
</div>

<div class="row g-4 mb-5">
    <!-- SPEAKER CARD -->
    <div class="col-lg-12">
        <div class="card bg-dark border-secondary p-4">
            <div class="d-flex flex-column flex-md-row gap-4 align-items-start">
                <img src="@(string.IsNullOrEmpty(Model.ProfileImage) ? "/images/default-avatar.png" : Model.ProfileImage)"
                     alt="@Model.FirstName @Model.LastName"
                     class="border border-secondary"
                     style="width: 120px; height: 120px; object-fit: cover;" />

                <div class="flex-grow-1 font-monospace">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <h2 class="h3 text-white m-0">@Model.FirstName @Model.LastName</h2>
                        @if (Model.IsFeatured)
                        {
                            <span class="badge bg-warning text-dark">FEATURED</span>
                        }
                    </div>

                    <p class="text-info m-0">
                        @Model.JobTitle.ToUpper() @(!string.IsNullOrEmpty(Model.Company) ? $"@ {Model.Company.ToUpper()}" : "")
                    </p>

                    <hr class="border-secondary my-3" />

                    <div>
                        <span class="text-muted d-block small mb-1">// BIOGRAPHY</span>
                        <p class="text-light m-0" style="line-height: 1.6;">@Model.Biography</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ASSOCIATED TALKS -->
    <div class="col-lg-12">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="h4 text-white font-monospace m-0">// TALKS BY THIS SPEAKER (@(Model.Talks?.Count ?? 0))</h3>
        </div>

        <div class="card bg-dark border-secondary">
            <div class="card-body p-0">
                <table class="table table-dark table-hover align-middle m-0">
                    <thead>
                        <tr class="border-bottom border-secondary font-monospace text-muted small">
                            <th class="ps-4">TALK TITLE</th>
                            <th>TYPE</th>
                            <th>CONFERENCE</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Talks == null || !Model.Talks.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center py-4 text-muted font-monospace">
                                    No talks assigned to this speaker yet.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var talk in Model.Talks)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <strong class="text-white">@talk.Title</strong>
                                    </td>
                                    <td class="font-monospace text-light">
                                        @talk.Track
                                    </td>
                                    <td class="font-monospace text-muted small">
                                        @(talk.Conference != null ? talk.Conference.Name : "Unassigned")
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>