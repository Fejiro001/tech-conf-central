@model IEnumerable<TechConfCentral.Models.Speaker>

@{
    ViewData["Title"] = "Admin - Speakers";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <span class="section-label d-block text-white-50  small">// MANAGEMENT</span>
        <h1 class="h2 text-white  m-0">SPEAKERS_</h1>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fa-solid fa-user-plus me-1"></i> CREATE NEW
    </a>
</div>

<div class="card bg-dark border-secondary">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle m-0">
                <thead>
                    <tr class="border-bottom border-secondary  text-white-50 small">
                        <th class="ps-4">#</th>
                        <th>SPEAKER</th>
                        <th>ROLE & COMPANY</th>
                        <th>STATUS</th>
                        <th>TALKS</th>
                        <th class="text-end pe-4">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-white-50 ">
                                No speakers found. Click "Create New" to add one.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var speaker in Model)
                        {
                            <tr>
                                <td class="ps-4  text-white-50">@speaker.Id</td>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@(string.IsNullOrEmpty(speaker.ProfileImage) ? "https://api.dicebear.com/10.x/notionists/svg?seed=Unknown" : speaker.ProfileImage)"
                                             alt="@speaker.FirstName @speaker.LastName"
                                             class="rounded-circle border border-secondary"
                                             style="width: 40px; height: 40px; object-fit: cover;" />
                                        <div>
                                            <strong class="text-white d-block">@speaker.FirstName @speaker.LastName</strong>
                                        </div>
                                    </div>
                                </td>
                                <td class=" text-light">
                                    <div>@speaker.JobTitle</div>
                                    <div class="text-white-50 small">@@@speaker.Company</div>
                                </td>
                                <td>
                                    @if (speaker.IsFeatured)
                                    {
                                        <span class="badge bg-warning text-dark rounded-0">
                                            <i class="fa-solid fa-star me-1"></i>FEATURED
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-dark border border-secondary text-white-50 rounded-0">STANDARD</span>
                                    }
                                </td>
                                <td class=" text-white-50 small">
                                    @(speaker.Talks?.Count ?? 0) talk(s)
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2 align-items-center btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@speaker.Id" class="btn btn-outline-info" title="Details">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@speaker.Id" class="btn btn-outline-warning" title="Edit">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@speaker.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete @speaker.FirstName @speaker.LastName?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>