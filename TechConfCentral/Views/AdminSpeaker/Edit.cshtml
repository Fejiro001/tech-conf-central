@model TechConfCentral.Models.Speaker

@{
    ViewData["Title"] = "Edit Speaker";
}

<div class="mb-4">
    <a asp-action="Index" class="text-white-50 text-decoration-none  small">
        <i class="fa-solid fa-arrow-left"></i> BACK TO LIST
    </a>
    <h1 class="h2 text-white mt-2">// EDIT SPEAKER #@Model.Id</h1>
</div>

<div class="row">
    <div>
        <div class="card bg-dark border-secondary p-4 rounded-0">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger  mb-3"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="FirstName" class="form-label  text-light">First Name</label>
                        <input asp-for="FirstName" class="form-control bg-dark text-white border-secondary" />
                        <span asp-validation-for="FirstName" class="text-danger  small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="LastName" class="form-label  text-light">Last Name</label>
                        <input asp-for="LastName" class="form-control bg-dark text-white border-secondary" />
                        <span asp-validation-for="LastName" class="text-danger  small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="JobTitle" class="form-label  text-light">Job Title</label>
                        <input asp-for="JobTitle" class="form-control bg-dark text-white border-secondary" />
                        <span asp-validation-for="JobTitle" class="text-danger  small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Company" class="form-label  text-light">Company / Organization</label>
                        <input asp-for="Company" class="form-control bg-dark text-white border-secondary" />
                        <span asp-validation-for="Company" class="text-danger  small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="ProfileImage" class="form-label  text-light">Profile Image URL</label>
                    <input asp-for="ProfileImage" class="form-control bg-dark text-white border-secondary" readonly/>
                    <span asp-validation-for="ProfileImage" class="text-danger  small"></span>
                </div>

                <div class="form-check form-switch mb-4">
                    <input asp-for="IsFeatured" class="form-check-input" type="checkbox" role="switch" id="isFeaturedSwitch">
                    <label class="form-check-label  text-light" for="isFeaturedSwitch">
                        Feature this speaker on homepage
                    </label>
                </div>

                <div class="mb-4">
                    <label asp-for="Biography" class="form-label  text-light">Biography</label>
                    <textarea asp-for="Biography" rows="5" class="form-control bg-dark text-white border-secondary"></textarea>
                    <span asp-validation-for="Biography" class="text-danger  small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-warning px-4">
                        <i class="fa-solid fa-pen me-1"></i> UPDATE SPEAKER
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary ">CANCEL</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}