@model IEnumerable<TechConfCentral.Models.Talk>

@{
    ViewData["Title"] = "Admin - Talks";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <span class="section-label d-block text-muted font-monospace small">// MANAGEMENT</span>
        <h1 class="h2 text-white font-monospace m-0">TALKS_</h1>
    </div>
    <a asp-action="Create" class="btn btn-outline-success font-monospace">
        <i class="fa-solid fa-plus me-1"></i> CREATE NEW
    </a>
</div>

<div class="card bg-dark border-secondary">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle m-0">
                <thead>
                    <tr class="border-bottom border-secondary font-monospace text-muted small">
                        <th class="ps-4">#</th>
                        <th>TALK TITLE</th>
                        <th>SPEAKER & TRACK</th>
                        <th>LOCATION</th>
                        <th>SCHEDULE</th>
                        <th>FLAGS</th>
                        <th class="text-end pe-4">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted font-monospace">
                                No talks configured. Click "Create New" to add one.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var talk in Model)
                        {
                            <tr>
                                <td class="ps-4 font-monospace text-muted">@talk.Id</td>
                                <td>
                                    <strong class="text-white d-block">@talk.Title</strong>
                                    <span class="text-muted font-monospace small">
                                        @(talk.Conference != null ? talk.Conference.Name : "No Conference")
                                    </span>
                                </td>
                                <td class="font-monospace text-light">
                                    <div>@(talk.Speaker != null ? $"{talk.Speaker.FirstName} {talk.Speaker.LastName}" : "Unassigned")</div>
                                    @if (talk.Track != null)
                                    {
                                        <span class="badge border small mt-1" style="background-color: @(talk.Track.Color ?? "#6c757d"); color: #fff;">
                                            @talk.Track.Name
                                        </span>
                                    }
                                </td>
                                <td class="font-monospace text-muted small">
                                    <i class="fa-solid fa-door-open me-1"></i>
                                    @(talk.Room != null ? talk.Room.Name : "TBA")
                                </td>
                                <td class="font-monospace text-muted small">
                                    <div>@talk.StartDateTime.ToString("MMM dd, yyyy")</div>
                                    <div class="text-info">@talk.StartDateTime.ToString("HH:mm") - @talk.EndDateTime.ToString("HH:mm")</div>
                                </td>
                                <td>
                                    <div class="d-flex flex-column gap-1">
                                        @if (talk.IsKeynote)
                                        {
                                            <span class="badge bg-warning text-dark font-monospace">KEYNOTE</span>
                                        }
                                        @if (talk.IsFeatured)
                                        {
                                            <span class="badge bg-info text-dark font-monospace">FEATURED</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@talk.Id" class="btn btn-outline-info" title="Details">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@talk.Id" class="btn btn-outline-warning" title="Edit">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@talk.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this talk?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>