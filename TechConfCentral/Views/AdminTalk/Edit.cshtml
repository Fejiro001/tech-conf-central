@model TalkFormViewModel

@{
    ViewData["Title"] = "Edit Talk";
}

<div class="mb-4">
    <a asp-action="Index" class="text-white-50 text-decoration-none  small">
        <i class="fa-solid fa-arrow-left"></i> BACK TO LIST
    </a>
    <h1 class="h2 text-white  mt-2">// EDIT TALK #@Model.Talk.Id</h1>
</div>

<div class="row">
    <div>
        <div class="card bg-dark border-secondary p-4 rounded-0">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Talk.Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger  mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Talk.Title" class="form-label  text-light">Talk Title</label>
                    <input asp-for="Talk.Title" class="form-control bg-dark text-white border-secondary" />
                    <span asp-validation-for="Talk.Title" class="text-danger  small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Talk.ConferenceId" class="form-label  text-light">Conference</label>
                        <select asp-for="Talk.ConferenceId" class="form-select bg-dark text-white border-secondary "
                                asp-items="@(new SelectList(Model.Conferences.Select(c => new {
                                    Id = c.Id,
                                    DisplayText = $"{c.Name} ({c.StartDate:yyyy-MM-dd} - {c.EndDate:yyyy-MM-dd})"
                                }), "Id", "DisplayText", Model.Talk.ConferenceId))">
                            <option value="">-- Select Conference --</option>
                        </select>
                        <span asp-validation-for="Talk.ConferenceId" class="text-danger  small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Talk.SpeakerId" class="form-label  text-light">Speaker</label>
                        <select asp-for="Talk.SpeakerId" class="form-select bg-dark text-white border-secondary "
                                asp-items="@(new SelectList(Model.Speakers.Select(s => new { Id = s.Id, Name = $"{s.FirstName} {s.LastName}" }), "Id", "Name", Model.Talk.SpeakerId))">
                            <option value="">-- Select Speaker --</option>
                        </select>
                        <span asp-validation-for="Talk.SpeakerId" class="text-danger  small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Talk.TrackId" class="form-label  text-light">Track</label>
                        <select asp-for="Talk.TrackId" class="form-select bg-dark text-white border-secondary "
                                asp-items="@(new SelectList(Model.Tracks, "Id", "Name", Model.Talk.TrackId))">
                            <option value="">-- Select Track --</option>
                        </select>
                        <span asp-validation-for="Talk.TrackId" class="text-danger  small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Talk.RoomId" class="form-label  text-light">Room / Venue Space</label>
                        <select asp-for="Talk.RoomId" class="form-select bg-dark text-white border-secondary "
                                asp-items="@(new SelectList(Model.Rooms, "Id", "Name", Model.Talk.RoomId))">
                            <option value="">-- Select Room --</option>
                        </select>
                        <span asp-validation-for="Talk.RoomId" class="text-danger  small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Talk.StartDateTime" class="form-label  text-light">Start Time</label>
                        <input asp-for="Talk.StartDateTime" type="datetime-local" value="@Model.Talk.StartDateTime.ToString("yyyy-MM-ddTHH:mm")" class="form-control bg-dark text-white border-secondary " />
                        <span asp-validation-for="Talk.StartDateTime" class="text-danger  small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Talk.EndDateTime" class="form-label  text-light">End Time</label>
                        <input asp-for="Talk.EndDateTime" type="datetime-local" value="@Model.Talk.EndDateTime.ToString("yyyy-MM-ddTHH:mm")" class="form-control bg-dark text-white border-secondary " />
                        <span asp-validation-for="Talk.EndDateTime" class="text-danger  small"></span>
                    </div>
                </div>

                <div class="d-flex gap-4 mb-4">
                    <div class="form-check form-switch">
                        <input asp-for="Talk.IsKeynote" class="form-check-input" type="checkbox" role="switch" id="isKeynoteSwitch">
                        <label class="form-check-label  text-light" for="isKeynoteSwitch">
                            Keynote Presentation
                        </label>
                    </div>

                    <div class="form-check form-switch">
                        <input asp-for="Talk.IsFeatured" class="form-check-input" type="checkbox" role="switch" id="isFeaturedSwitch">
                        <label class="form-check-label  text-light" for="isFeaturedSwitch">
                            Feature on Schedule Header
                        </label>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Talk.Description" class="form-label  text-light">Talk Abstract / Description</label>
                    <textarea asp-for="Talk.Description" rows="5" class="form-control bg-dark text-white border-secondary"></textarea>
                    <span asp-validation-for="Talk.Description" class="text-danger  small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-warning  px-4">
                        <i class="fa-solid fa-pen me-1"></i> UPDATE TALK
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary ">CANCEL</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}