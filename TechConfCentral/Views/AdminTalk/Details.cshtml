@model TechConfCentral.Models.Talk

@{
    ViewData["Title"] = "Talk Details";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <a asp-action="Index" class="text-white-50 text-decoration-none  small">
            <i class="fa-solid fa-arrow-left"></i> BACK TO LIST
        </a>
        <h1 class="h2 text-white  mt-1">// DETAILS: TALK #@Model.Id</h1>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning ">
            <i class="fa-solid fa-pen me-1"></i> EDIT
        </a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this talk?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger h-100">
                <i class="fa-solid fa-trash me-1"></i> DELETE
            </button>
        </form>
    </div>
</div>

<div class="row g-4 mb-5">
    <!-- TALK OVERVIEW -->
    <div class="col-lg-12">
        <div class="card bg-dark border-secondary p-4 rounded-0">
            <div class="d-flex align-items-center gap-2 mb-2">
                @if (Model.Track != null)
                {
                    <span class="badge border rounded-0" style="border-left:5px solid @Model.Track.Color !important; background-color:var(--neutral-900);">
                        @Model.Track.Name
                    </span>
                }
                @if (Model.IsFeatured)
                {
                    <span class="badge bg-info text-dark rounded-0">FEATURED</span>
                }
            </div>

            <h2 class="h3 text-white  mb-3">@Model.Title</h2>

            <div class="row g-3  mb-4">
                <div class="col-md-3">
                    <span class="text-white-50 d-block small">// CONFERENCE</span>
                    <span class="text-light">@(Model.Conference?.Name ?? "Unassigned")</span>
                </div>
                <div class="col-md-3">
                    <span class="text-white-50 d-block small">// ROOM</span>
                    <span class="text-light">@(Model.Room?.Name ?? "TBA")</span>
                </div>
                <div class="col-md-3">
                    <span class="text-white-50 d-block small">// START TIME</span>
                    <span class="text-info">@Model.StartDateTime.ToString("MMM dd, yyyy HH:mm")</span>
                </div>
                <div class="col-md-3">
                    <span class="text-white-50 d-block small">// END TIME</span>
                    <span class="text-info">@Model.EndDateTime.ToString("MMM dd, yyyy HH:mm")</span>
                </div>
            </div>

            <hr class="border-secondary my-3" />

            <!-- SPEAKER INFO -->
            <div class="mb-4">
                <span class="text-white-50  d-block small mb-2">// SPEAKER</span>
                @if (Model.Speaker != null)
                {
                    <div class="d-flex align-items-center gap-3">
                        <img src="@(string.IsNullOrEmpty(Model.Speaker.ProfileImage) ? "/images/default-avatar.png" : Model.Speaker.ProfileImage)"
                             alt="@Model.Speaker.FirstName @Model.Speaker.LastName"
                             class="rounded-circle border border-secondary"
                             style="width: 48px; height: 48px; object-fit: cover;" />
                        <div class="">
                            <strong class="text-white d-block">@Model.Speaker.FirstName @Model.Speaker.LastName</strong>
                            <span class="text-white-50 small">@Model.Speaker.JobTitle @@ @Model.Speaker.Company</span>
                        </div>
                    </div>
                }
                else
                {
                    <span class="text-white-50 ">No speaker assigned yet.</span>
                }
            </div>

            <hr class="border-secondary my-3" />

            <div>
                <span class="text-white-50  d-block small mb-1">// DESCRIPTION</span>
                <p class="text-light  m-0" style="line-height: 1.6;">@Model.Description</p>
            </div>
        </div>
    </div>
</div>