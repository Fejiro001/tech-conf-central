@model TechConfCentral.Models.Talk

@{
    ViewData["Title"] = "Create Talk";
}

<div class="mb-4">
    <a asp-action="Index" class="text-muted text-decoration-none font-monospace small">
        &larr; BACK TO LIST
    </a>
    <h1 class="h2 text-white font-monospace mt-2">// CREATE TALK</h1>
</div>

<div class="row">
    <div class="col-lg-9">
        <div class="card bg-dark border-secondary p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger font-monospace mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label font-monospace text-light">Talk Title</label>
                    <input asp-for="Title" class="form-control bg-dark text-white border-secondary" placeholder="e.g. Building Scalable Web APIs with ASP.NET Core" />
                    <span asp-validation-for="Title" class="text-danger font-monospace small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="ConferenceId" class="form-label font-monospace text-light">Conference</label>
                        <select asp-for="ConferenceId" class="form-select bg-dark text-white border-secondary font-monospace" asp-items="ViewBag.ConferenceId">
                            <option value="">-- Select Conference --</option>
                        </select>
                        <span asp-validation-for="ConferenceId" class="text-danger font-monospace small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="SpeakerId" class="form-label font-monospace text-light">Speaker</label>
                        <select asp-for="SpeakerId" class="form-select bg-dark text-white border-secondary font-monospace" asp-items="ViewBag.SpeakerId">
                            <option value="">-- Select Speaker --</option>
                        </select>
                        <span asp-validation-for="SpeakerId" class="text-danger font-monospace small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="TrackId" class="form-label font-monospace text-light">Track</label>
                        <select asp-for="TrackId" class="form-select bg-dark text-white border-secondary font-monospace" asp-items="ViewBag.TrackId">
                            <option value="">-- Select Track --</option>
                        </select>
                        <span asp-validation-for="TrackId" class="text-danger font-monospace small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="RoomId" class="form-label font-monospace text-light">Room / Venue Space</label>
                        <select asp-for="RoomId" class="form-select bg-dark text-white border-secondary font-monospace" asp-items="ViewBag.RoomId">
                            <option value="">-- Select Room --</option>
                        </select>
                        <span asp-validation-for="RoomId" class="text-danger font-monospace small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="StartDateTime" class="form-label font-monospace text-light">Start Time</label>
                        <input asp-for="StartDateTime" type="datetime-local" class="form-control bg-dark text-white border-secondary font-monospace" />
                        <span asp-validation-for="StartDateTime" class="text-danger font-monospace small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="EndDateTime" class="form-label font-monospace text-light">End Time</label>
                        <input asp-for="EndDateTime" type="datetime-local" class="form-control bg-dark text-white border-secondary font-monospace" />
                        <span asp-validation-for="EndDateTime" class="text-danger font-monospace small"></span>
                    </div>
                </div>

                <div class="d-flex gap-4 mb-4">
                    <div class="form-check form-switch">
                        <input asp-for="IsKeynote" class="form-check-input" type="checkbox" role="switch" id="isKeynoteSwitch">
                        <label class="form-check-label font-monospace text-light" for="isKeynoteSwitch">
                            Keynote Presentation
                        </label>
                    </div>

                    <div class="form-check form-switch">
                        <input asp-for="IsFeatured" class="form-check-input" type="checkbox" role="switch" id="isFeaturedSwitch">
                        <label class="form-check-label font-monospace text-light" for="isFeaturedSwitch">
                            Feature on Schedule Header
                        </label>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label font-monospace text-light">Talk Abstract / Description</label>
                    <textarea asp-for="Description" rows="5" class="form-control bg-dark text-white border-secondary" placeholder="Detailed outline of the session..."></textarea>
                    <span asp-validation-for="Description" class="text-danger font-monospace small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success font-monospace px-4">
                        <i class="fa-solid fa-check me-1"></i> SAVE TALK
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary font-monospace">CANCEL</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}